        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/blue_shadow</item>
    </style>

    <style
        name="ElementCardView"
        parent="@style/Widget.MaterialComponents.TextView">
        <item name="android:textSize">20sp</item>
