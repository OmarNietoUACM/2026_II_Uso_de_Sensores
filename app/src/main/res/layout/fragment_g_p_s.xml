<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GPSFragment">



    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:elevation="16dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/tv_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nombre"
                style="@style/TitleCardView"
                />
            <TextView
                android:id="@+id/tv_latitud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="latitud ="
                style="@style/ElementCardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_longitud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Longitud ="
                style="@style/ElementCardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_altitud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="altitud ="
                style="@style/ElementCardView"
                android:layout_marginStart="16dp"
                />

            <TextView
                android:id="@+id/tv_fecha_hora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="exactitud="
                style="@style/ElementCardView"
                android:layout_marginStart="16dp"
                />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>