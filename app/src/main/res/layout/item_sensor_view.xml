<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_view"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:elevation="16dp"
        app:cardCornerRadius="8dp"
        android:clickable="true"
        android:focusable="true"
        android:checkable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/tv_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nombre"
                android:textStyle="bold"
                android:textSize="20sp"
                />
            <TextView
                android:id="@+id/tv_vendedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="vendedor"
                style="@style/ElementItemcardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="version"
                style="@style/ElementItemcardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_tipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tipo"
                style="@style/ElementItemcardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_maxRan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="maxRan"
                style="@style/ElementItemcardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_resolucion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="resolucion"
                style="@style/ElementItemcardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_potencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="potencia"
                style="@style/ElementItemcardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_minDelay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="minDelay"
                style="@style/ElementItemcardView"
                android:layout_marginStart="16dp"
                />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>