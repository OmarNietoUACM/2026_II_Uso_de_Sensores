<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SensorDetailFragment">



    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Regresar"
            android:src="@drawable/main_tool_bar3"
            android:background="@drawable/main_tool_bar3"
            app:navigationIcon="@drawable/arrow_back_48dp"
            app:navigationIconTint="#EF6C00"
            style="@style/Widget.MaterialComponents.Toolbar.Primary"
            />

    </com.google.android.material.appbar.AppBarLayout>



    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:elevation="16dp"
        app:cardCornerRadius="8dp"
        android:layout_centerInParent="true"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/tv_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin nombre"
                style="@style/TitleCardView"
                />
            <TextView
                android:id="@+id/tv_valores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="valores = ?"
                style="@style/ElementCardView"
                android:layout_marginStart="16dp"
                />
            <TextView
                android:id="@+id/tv_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="timestamp = ?"
                style="@style/ElementCardView"
                android:layout_marginStart="16dp"
                />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>